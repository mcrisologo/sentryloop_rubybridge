# Kill switch — default off
SENTRY_AUTO_FIX_ENABLED=false

# Path token (required)
SENTRY_AUTO_FIX_WEBHOOK_TOKEN=long-random-path-token

# Prefer HMAC (default require_hmac=true)
SENTRY_AUTO_FIX_HMAC_SECRET=sentry-integration-client-secret
# SENTRY_AUTO_FIX_REQUIRE_HMAC=false   # only for header-only hosts
# SENTRY_AUTO_FIX_WEBHOOK_SECRET=optional-header-secret
# SENTRY_AUTO_FIX_WEBHOOK_SECRET_HEADER=X-Sentry-Loop-Webhook-Secret
# SENTRY_AUTO_FIX_HMAC_MAX_SKEW_SECONDS=300

# GitHub repository_dispatch target (required; no defaults)
SENTRY_AUTO_FIX_GITHUB_PAT=ghp_...
SENTRY_AUTO_FIX_GITHUB_OWNER=your-org
SENTRY_AUTO_FIX_GITHUB_REPO=your-repo

# Optional
# SENTRY_AUTO_FIX_ALLOWED_ENVIRONMENTS=production
# SENTRY_AUTO_FIX_IDEMPOTENCY_TTL_SECONDS=21600
# SENTRY_AUTO_FIX_MAX_STACK_CHARS=8000
# SENTRY_AUTO_FIX_EVENT_TYPE=sentry_issue
